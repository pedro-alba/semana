# Semana configuration. Copy to .env.local (outside git) and run:
#   uv run --env-file .env.local uvicorn semana.app:app

# SQLite database (created and migrated when the server starts).
SEMANA_DB=./dev.sqlite3

# Public address, used in the password recovery link.
SEMANA_BASE_URL=http://localhost:8000

# 0 only in development without HTTPS (cookie without "Secure"). In production, delete the line.
SEMANA_SECURE_COOKIE=0

# E-mail (password recovery). Without SEMANA_SMTP_HOST, the link shows up in the server log.
# Any SMTP provider with STARTTLS on port 587 works (Brevo, Amazon SES, Resend, Postmark…).
SEMANA_SMTP_HOST=
SEMANA_SMTP_PORT=587
SEMANA_SMTP_USER=
SEMANA_SMTP_PASSWORD=
SEMANA_SMTP_FROM=Semana <no-reply@your-domain>

# Folder with this instance's own files, which replace the app's.
# Today: terms.html, terms.pt-BR.html, privacy.html and privacy.pt-BR.html
# (the repository ones are templates with [PLACEHOLDERS]).
SEMANA_CUSTOM_DIR=

# Source code address of this instance (https://…), shown in the profile menu.
# The AGPL-3.0 asks whoever hosts a modified version to offer the code to its users.
SEMANA_SOURCE_URL=
